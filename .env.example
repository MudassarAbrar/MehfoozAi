# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
# Not referenced by any application code — set it only if a hosting platform
# requires it (never ship placeholder values).
# APP_URL="https://your-app.example.com"

# Sender identity for complaint emails (Resend requires a verified domain).
EMAIL_FROM="Mehfooz Legal Protection <no-reply@mehfooz.pk>"

# Supabase (Auth + Postgres with Row Level Security). When omitted, the app
# falls back to the legacy localStorage auth/data engine.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side Supabase (JWT verification for protected API routes)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Twilio SMS dispatch (server-side only, never exposed to the client bundle)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Resend email dispatch for formal complaints (server-side only)
# Leave RESEND_API_KEY empty for honest simulated dispatch; to go live:
#   1. Verify your sender domain at https://resend.com/domains
#   2. Set COMPLAINT_RECIPIENT_EMAIL to the official authority inbox
RESEND_API_KEY=
COMPLAINT_RECIPIENT_EMAIL=

# Gemini Agent configuration (function-calling loop)
GEMINI_AGENT_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-1.5-flash
GEMINI_AGENT_MAX_ITERATIONS=4
GEMINI_AGENT_TIMEOUT_MS=30000
GEMINI_AGENT_MAX_TOOL_CALLS=8
GEMINI_AGENT_MAX_HISTORY_MESSAGES=30
